# ---- Server ----
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- MySQL ----
# On Railway, use the connection values from the MySQL plugin.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acadhr_crm

# ---- First admin (used by `npm run seed`) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@acadhr.com
SEED_ADMIN_PASSWORD=admin123

# ---- AcadHr source for "Fetch from AcadHr" ----
# If the AcadHr data is on the SAME MySQL server as the CRM, you can leave the
# ACADHR_DB_* vars blank and (optionally) set the schema name:
ACADHR_SOURCE_DB=acadhr
# If the AcadHr data is on a DIFFERENT server, set these to point at it:
ACADHR_DB_HOST=
ACADHR_DB_PORT=3306
ACADHR_DB_USER=
ACADHR_DB_PASSWORD=
ACADHR_DB_NAME=acadhr
ACADHR_DB_SSL=false
